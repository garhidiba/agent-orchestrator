{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "reviewed_sha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "changes_requested"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$))[^\\x00-\\x1f\\x7f]*$"
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "line_start": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "line_end": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "reproduction": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "string",
            "minLength": 1
          },
          "suggested_test": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
            }
          },
          "status": {
            "type": "string",
            "const": "open"
          }
        },
        "required": [
          "id",
          "severity",
          "category",
          "path",
          "symbol",
          "line_start",
          "line_end",
          "summary",
          "evidence",
          "reproduction",
          "acceptance",
          "suggested_test",
          "acceptance_ids",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "reviewed_areas": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_ids": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
      }
    }
  },
  "required": [
    "schema_version",
    "reviewed_sha",
    "reviewer_id",
    "decision",
    "findings",
    "reviewed_areas",
    "limitations",
    "acceptance_ids"
  ],
  "additionalProperties": false
}
