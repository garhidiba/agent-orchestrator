{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "approved": {
      "type": "boolean",
      "const": true
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "previous_coordinator_stopped": {
      "type": "boolean",
      "const": true
    },
    "force": {
      "default": false,
      "type": "boolean"
    },
    "stopped_agents": {
      "default": [],
      "maxItems": 1024,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
      }
    },
    "never_started_tasks": {
      "default": [],
      "maxItems": 1024,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
      }
    },
    "never_started_reviews": {
      "default": [],
      "maxItems": 1024,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
      }
    }
  },
  "required": [
    "approved",
    "reason",
    "previous_coordinator_stopped",
    "force",
    "stopped_agents",
    "never_started_tasks",
    "never_started_reviews"
  ],
  "additionalProperties": false
}
