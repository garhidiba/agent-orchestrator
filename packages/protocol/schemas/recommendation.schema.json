{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "enum": [
        "global",
        "project",
        "session"
      ]
    },
    "host": {
      "type": "string",
      "enum": [
        "codex",
        "claude"
      ]
    },
    "configRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "proposedPatch": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "add"
              },
              "path": {
                "type": "string",
                "pattern": "^\\/(?:[^~\\x00-\\x1f]|~[01])+$"
              },
              "value": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": [
              "op",
              "path",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "replace"
              },
              "path": {
                "type": "string",
                "pattern": "^\\/(?:[^~\\x00-\\x1f]|~[01])+$"
              },
              "value": {
                "$ref": "#/$defs/__schema1"
              }
            },
            "required": [
              "op",
              "path",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "remove"
              },
              "path": {
                "type": "string",
                "pattern": "^\\/(?:[^~\\x00-\\x1f]|~[01])+$"
              }
            },
            "required": [
              "op",
              "path"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "coordinator",
              "requirements",
              "planner",
              "coder",
              "tester",
              "reviewer",
              "repair",
              "final_auditor"
            ]
          },
          "modelId": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "reasons": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "required": [
          "role",
          "modelId",
          "effort",
          "reasons",
          "evidenceRefs",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "preservedOverrides": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiresApproval": {
      "type": "boolean"
    }
  },
  "required": [
    "scope",
    "host",
    "configRevision",
    "proposedPatch",
    "selections",
    "preservedOverrides",
    "warnings",
    "requiresApproval"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  }
}
