{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACCEPTED_RISK",
        "NOT_A_BUG",
        "DEFERRED"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "approved": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "finding_id",
    "status",
    "reason",
    "approved"
  ],
  "additionalProperties": false
}
